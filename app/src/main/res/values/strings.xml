    <!-- Helper setup -->
    <string name="the_carplay_app">the CarPlay app</string>
    <string name="setup_overline">One-time setup</string>
    <string name="setup_title">Turn on the helper</string>
    <string name="setup_body">Android won’t let one app close another, so a small helper does the tapping: for Restart it presses Force stop on %1$s and opens it again, and for Reboot it uses the power menu. It only acts right after you press a button.</string>
    <string name="setup_step1">Tap <b>Open settings</b> below.</string>
    <string name="setup_step2">Find <b>CarPlay Restart</b> (it can be under Downloaded apps or Installed services) and turn it on.</string>
    <string name="setup_step3">Says <b>Restricted setting</b>? Go to Settings › Apps › CarPlay Restart, tap ⋮ at the top, choose <b>Allow restricted settings</b>, then try again.</string>
    <string name="setup_open">Open settings</string>
    <string name="not_now">Not now</string>
    <string name="helper_description">Lets CarPlay Restart close and reopen your CarPlay app when you press Restart: it opens the app’s App info page, presses Force stop, then opens the app again and, if you picked one in Settings, presses its Apple CarPlay or Android Auto button. When you hold Reboot radio, it opens the power menu and presses Restart. It acts only right after you press one of those buttons, and it doesn’t read, save or send anything else.</string>

