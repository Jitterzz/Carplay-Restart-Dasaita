<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarPlayRestart" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent_light</item>
        <!-- Sora everywhere unless a view or the look says otherwise. -->
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:alertDialogTheme">@style/Dialog.CarPlayRestart</item>
    </style>

    <!-- The widget's quick restart: no window to see, no animation in or out. -->
    <style name="Theme.CarPlayRestart.Invisible" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- The app picker and the TalkBack reboot question, for dark looks (the look's card is put on in code). -->
    <style name="Dialog.CarPlayRestart" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent_light</item>
        <item name="android:fontFamily">@font/sora_regular</item>
    </style>

    <!-- The same for light looks (Sakura). -->
    <style name="Dialog.CarPlayRestart.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">#C2185B</item>
        <item name="android:fontFamily">@font/sora_regular</item>
    </style>

    <!-- The setup card draws its own card, so its window is see-through. -->
    <style name="GlassDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:fontFamily">@font/sora_regular</item>
    </style>

    <!-- Small spaced-out capitals over groups and stats. -->
    <style name="Overline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:tag">label|t3</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SectionLabel" parent="Overline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Settings: a section's heading and the line under it. -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:tag">strong|t1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SectionLead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:tag">body|t2</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Settings: a row's name and the explanation under it. -->
    <style name="RowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:tag">strong|t1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RowSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:tag">body|t2</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <!-- A rounded action button in the look's colors. -->
    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_pill_accent</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:tag">pill</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- A round icon tile at the start of a Settings card. -->
    <style name="RowIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">11dp</item>
        <item name="android:tag">tile|accent</item>
    </style>

    <!-- One choice in the "Open it as" row; the selected one gets the pill background in code. -->
    <style name="ModeChoice">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/bg_seg_off</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
