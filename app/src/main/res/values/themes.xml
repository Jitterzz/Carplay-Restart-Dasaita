<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarPlayRestart" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent_light</item>
        <!-- Sora everywhere unless a view says otherwise. -->
        <item name="android:fontFamily">@font/sora_regular</item>
        <item name="android:alertDialogTheme">@style/Dialog.CarPlayRestart</item>
    </style>

    <!-- The app picker and the TalkBack reboot question: dark glass with rounded corners. -->
    <style name="Dialog.CarPlayRestart" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent_light</item>
        <item name="android:fontFamily">@font/sora_regular</item>
    </style>

    <!-- The setup card draws its own glass, so its window is see-through. -->
    <style name="GlassDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:fontFamily">@font/sora_regular</item>
    </style>

    <!-- Small spaced-out capitals over groups and stats. -->
    <style name="Overline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SectionLabel" parent="Overline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- One choice in the "Open it as" row; the selected one gets the blue pill background in code. -->
    <style name="ModeChoice">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:background">@drawable/bg_seg_off</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
