<?xml version="1.0" encoding="utf-8"?>
<!-- The helper (see HelperService.kt). It needs window content to find the Force stop / OK / Restart buttons and to
     tell whether the CarPlay app is showing CarPlay (auto-fix), gestures to tap buttons that don't answer an
     ordinary click, and taps and scrolls in the CarPlay app so auto-fix waits while someone is using it. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/helper_description"
    android:notificationTimeout="100"
    android:settingsActivity="app.carplayrestart.SettingsActivity" />
