<?xml version="1.0" encoding="utf-8"?>
<!-- The glowing Restart orb (OrbView paints the glow, gauge, comets and sphere; these are the words on it). -->
<app.carplayrestart.OrbView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:clickable="true"
    android:contentDescription="@string/orb_description"
    android:focusable="true"
    android:stateListAnimator="@animator/press_scale">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/orb_icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/ic_restart"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/orb_label"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/sora_bold"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/orb_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:ellipsize="end"
            android:fontFamily="@font/sora_semibold"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#D6E4FF"
            android:textSize="12sp" />
    </LinearLayout>
</app.carplayrestart.OrbView>
