<?xml version="1.0" encoding="utf-8"?>
<!-- "Turn on the helper": a glass card with three numbered steps. -->
<app.carplayrestart.GlassLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:glassAccent="@color/accent_light"
    app:glassFill="@color/glass_solid"
    app:glassRadius="28dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_orb_small"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_restart"
                    android:tint="#FFFFFF"
                    android:tag="logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Overline"
                        android:text="@string/setup_overline"
                        android:textColor="@color/accent_light"
                        android:tag="label|accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sora_bold"
                        android:text="@string/setup_title"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:tag="strong|t1" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/setup_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:tag="body|t2" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/hairline"
                android:tag="hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="@font/sora_bold"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:tag="logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:paddingTop="3dp"
                    android:text="@string/setup_step1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:tag="body|t1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="@font/sora_bold"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:tag="logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:paddingTop="3dp"
                    android:text="@string/setup_step2"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:tag="body|t1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="@font/sora_bold"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:tag="logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:paddingTop="3dp"
                    android:text="@string/setup_step3"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:tag="body|t1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/setup_later"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/sora_semibold"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/not_now"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:tag="strong|t2" />

                <TextView
                    android:id="@+id/setup_open"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_accent"
                    android:fontFamily="@font/sora_semibold"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/setup_open"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:tag="pill" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</app.carplayrestart.GlassLayout>
