<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › CarPlay app: which app to restart, whether to open it again, and as what. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sec_app"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SectionTitle"
        android:text="@string/nav_app" />

    <TextView
        style="@style/SectionLead"
        android:text="@string/sec_app_lead" />

    <app.carplayrestart.GlassLayout
        android:id="@+id/app_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:glassRadius="20dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_icon_tile"
            android:tag="tile">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_app_placeholder" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_name"
                style="@style/RowTitle"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/app_pkg"
                style="@style/RowSub"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/sora_semibold"
            android:tag="strong|accent"
            android:text="@string/change"
            android:textColor="@color/accent_light"
            android:textSize="15sp" />
    </app.carplayrestart.GlassLayout>

    <app.carplayrestart.GlassLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:glassRadius="20dp">

        <LinearLayout
            android:id="@+id/reopen_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/reopen_title" />

                <TextView
                    style="@style/RowSub"
                    android:text="@string/reopen_sub" />
            </LinearLayout>

            <Switch
                android:id="@+id/reopen_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:tag="switch"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track" />
        </LinearLayout>

        <!-- "Open it as": dims while "open it again" is off -->
        <LinearLayout
            android:id="@+id/mode_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Overline"
                android:text="@string/mode_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mode_auto"
                    style="@style/ModeChoice"
                    android:text="@string/mode_auto" />

                <TextView
                    android:id="@+id/mode_carplay"
                    style="@style/ModeChoice"
                    android:layout_marginStart="8dp"
                    android:text="@string/mode_carplay" />

                <TextView
                    android:id="@+id/mode_android"
                    style="@style/ModeChoice"
                    android:layout_marginStart="8dp"
                    android:text="@string/mode_android" />
            </LinearLayout>

            <TextView
                style="@style/RowSub"
                android:layout_marginTop="8dp"
                android:text="@string/mode_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </app.carplayrestart.GlassLayout>
</LinearLayout>
