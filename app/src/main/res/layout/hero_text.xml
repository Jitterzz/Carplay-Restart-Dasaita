<?xml version="1.0" encoding="utf-8"?>
<!-- The icon and words on the Restart button. Whatever the look, HeroView sizes them to the button and sets their
     fonts and colors; the look paints the button itself behind them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/orb_icon"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:src="@drawable/ic_restart" />

    <TextView
        android:id="@+id/orb_label"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="30sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1" />

    <TextView
        android:id="@+id/orb_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="12sp" />
</LinearLayout>
