<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Helper & root: how this radio restarts apps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sec_helper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        style="@style/SectionTitle"
        android:text="@string/nav_helper" />

    <TextView
        style="@style/SectionLead"
        android:text="@string/sec_helper_lead" />

    <app.carplayrestart.GlassLayout
        android:id="@+id/helper_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:glassRadius="20dp">

        <app.carplayrestart.PulseDot
            android:id="@+id/helper_dot"
            android:layout_width="30dp"
            android:layout_height="30dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/RowTitle"
                android:text="@string/helper_title" />

            <TextView
                android:id="@+id/helper_status"
                style="@style/RowSub" />
        </LinearLayout>

        <TextView
            android:id="@+id/helper_button"
            style="@style/PillButton"
            android:layout_marginStart="10dp" />
    </app.carplayrestart.GlassLayout>

    <app.carplayrestart.GlassLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        app:glassRadius="20dp">

        <app.carplayrestart.PulseDot
            android:id="@+id/root_dot"
            android:layout_width="30dp"
            android:layout_height="30dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/RowTitle"
                android:text="@string/root_title" />

            <TextView
                android:id="@+id/root_status"
                style="@style/RowSub" />
        </LinearLayout>
    </app.carplayrestart.GlassLayout>

    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:tag="body|t3"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />
</LinearLayout>
