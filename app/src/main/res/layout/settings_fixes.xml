<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Fixes: clear the CarPlay app's cache, and turn Wi-Fi and Bluetooth off and on (root only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sec_fixes"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        style="@style/SectionTitle"
        android:text="@string/nav_fixes" />

    <TextView
        style="@style/SectionLead"
        android:text="@string/sec_fixes_lead" />

    <app.carplayrestart.GlassLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        app:glassRadius="20dp">

        <ImageView
            style="@style/RowIcon"
            android:src="@drawable/ic_clean"
            android:tint="@color/accent_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/RowTitle"
                android:text="@string/cache_title" />

            <TextView
                android:id="@+id/cache_sub"
                style="@style/RowSub" />
        </LinearLayout>

        <TextView
            android:id="@+id/cache_button"
            style="@style/PillButton"
            android:layout_marginStart="12dp"
            android:text="@string/cache_button" />
    </app.carplayrestart.GlassLayout>

    <app.carplayrestart.GlassLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        app:glassRadius="20dp">

        <ImageView
            style="@style/RowIcon"
            android:src="@drawable/ic_wifi"
            android:tint="@color/accent_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/RowTitle"
                android:text="@string/wireless_title" />

            <TextView
                android:id="@+id/wireless_sub"
                style="@style/RowSub" />
        </LinearLayout>

        <TextView
            android:id="@+id/wireless_button"
            style="@style/PillButton"
            android:layout_marginStart="12dp"
            android:text="@string/wireless_button" />
    </app.carplayrestart.GlassLayout>
</LinearLayout>
