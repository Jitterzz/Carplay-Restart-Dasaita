<?xml version="1.0" encoding="utf-8"?>
<!-- One look in Settings › Look: a little picture of it, its name and a few words. -->
<app.carplayrestart.GlassLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="8dp"
    app:glassRadius="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <app.carplayrestart.ThemeSwatch
            android:id="@+id/theme_swatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/theme_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:tag="logo"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/theme_name"
        style="@style/RowTitle"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/theme_tagline"
        style="@style/RowSub"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textSize="12sp" />
</app.carplayrestart.GlassLayout>
