<?xml version="1.0" encoding="utf-8"?>
<!-- "Turn on the helper" on the radio's wide screen: what it is on the left, the steps and buttons on the right,
     so the whole card (and Open settings) fits on screen without scrolling. -->
<app.carplayrestart.GlassLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:glassAccent="@color/accent_light"
    app:glassFill="@color/glass_solid"
    app:glassRadius="28dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="26dp">

            <!-- Left: what the helper is -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_orb_small"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_jumpstart"
                        android:tint="#FFFFFF"
                        android:tag="logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Overline"
                            android:text="@string/setup_overline"
                            android:textColor="@color/accent_light"
                            android:tag="label|accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/sora_bold"
                            android:text="@string/setup_title"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:tag="strong|t1" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/setup_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:tag="body|t2" />
            </LinearLayout>

            <!-- Right: the three steps, then the buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_weight="1.1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge"
                        android:fontFamily="@font/sora_bold"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:tag="logo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:paddingTop="2dp"
                        android:text="@string/setup_step1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:tag="body|t1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge"
                        android:fontFamily="@font/sora_bold"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:tag="logo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:paddingTop="2dp"
                        android:text="@string/setup_step2"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:tag="body|t1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge"
                        android:fontFamily="@font/sora_bold"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:tag="logo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:paddingTop="2dp"
                        android:text="@string/setup_step3"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:tag="body|t1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/setup_later"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:fontFamily="@font/sora_semibold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/not_now"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:tag="strong|t2" />

                    <TextView
                        android:id="@+id/setup_open"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_accent"
                        android:fontFamily="@font/sora_semibold"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/setup_open"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:tag="pill" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</app.carplayrestart.GlassLayout>
