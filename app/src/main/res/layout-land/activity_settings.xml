<?xml version="1.0" encoding="utf-8"?>
<!-- The radio's wide screen: the CarPlay app and how it reopens on the left, how it restarts on the right.
     Sized to fit the radio's screen without scrolling (the ScrollView is only a safety net). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <app.carplayrestart.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="28dp">

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/back"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back"
                    android:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/sora_bold"
                    android:text="@string/settings"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="12dp">

                    <!-- Left: which app, and how it opens again -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionLabel"
                            android:layout_marginTop="2dp"
                            android:text="@string/section_app" />

                        <app.carplayrestart.GlassLayout
                            android:id="@+id/app_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            app:glassRadius="20dp">

                            <FrameLayout
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_tile">

                                <ImageView
                                    android:id="@+id/app_icon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_app_placeholder" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/app_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/sora_semibold"
                                    android:maxLines="1"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp" />

                                <TextView
                                    android:id="@+id/app_pkg"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/sora_semibold"
                                android:text="@string/change"
                                android:textColor="@color/accent_light"
                                android:textSize="15sp" />
                        </app.carplayrestart.GlassLayout>

                        <app.carplayrestart.GlassLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical"
                            android:padding="14dp"
                            app:glassRadius="20dp">

                            <LinearLayout
                                android:id="@+id/reopen_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/sora_semibold"
                                        android:text="@string/reopen_title"
                                        android:textColor="@color/text_primary"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/reopen_sub"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <Switch
                                    android:id="@+id/reopen_switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:thumbTint="@color/switch_thumb"
                                    android:trackTint="@color/switch_track" />
                            </LinearLayout>

                            <!-- "Open it as": dims while "open it again" is off -->
                            <LinearLayout
                                android:id="@+id/mode_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Overline"
                                    android:text="@string/mode_title" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/mode_auto"
                                        style="@style/ModeChoice"
                                        android:text="@string/mode_auto" />

                                    <TextView
                                        android:id="@+id/mode_carplay"
                                        style="@style/ModeChoice"
                                        android:layout_marginStart="8dp"
                                        android:text="@string/mode_carplay" />

                                    <TextView
                                        android:id="@+id/mode_android"
                                        style="@style/ModeChoice"
                                        android:layout_marginStart="8dp"
                                        android:text="@string/mode_android" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/mode_sub"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </app.carplayrestart.GlassLayout>
                    </LinearLayout>

                    <!-- Right: helper and root -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionLabel"
                            android:layout_marginTop="2dp"
                            android:text="@string/section_how" />

                        <app.carplayrestart.GlassLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp"
                            app:glassRadius="20dp">

                            <app.carplayrestart.PulseDot
                                android:id="@+id/helper_dot"
                                android:layout_width="30dp"
                                android:layout_height="30dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/sora_semibold"
                                    android:text="@string/helper_title"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/helper_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/helper_button"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_pill_accent"
                                android:fontFamily="@font/sora_semibold"
                                android:gravity="center"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp" />
                        </app.carplayrestart.GlassLayout>

                        <app.carplayrestart.GlassLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp"
                            app:glassRadius="20dp">

                            <app.carplayrestart.PulseDot
                                android:id="@+id/root_dot"
                                android:layout_width="30dp"
                                android:layout_height="30dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/sora_semibold"
                                    android:text="@string/root_title"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/root_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12.5sp" />
                            </LinearLayout>
                        </app.carplayrestart.GlassLayout>

                        <TextView
                            android:id="@+id/version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
